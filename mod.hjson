#the mod name as displayed in-game
displayName: "Ability Additions"

#the internal name of your mod
name: "ability-additions"

#your name
author: "KROZO"

#the fully qualified main class of the mod (keep this until Code Time!)
main: "abilityadditions.AbilityAdditionsMod"

#the mod description as seen in the mod dialog
description: "Gives Serpulo and Erekir turrets (and later units) triggered abilities so defense feels like more than just spamming bullets. Built as an addon for Mindustry Overhaul, adding bonus damage, status debuffs, and flashy bullet-colored effects. (WIP)"

#the mod version
version: 0.1.0

#the minimum game build required to run this mod
minGameVersion: 160.7

#required dependency mods
dependencies: [
  mov
]

#this is a java mod
java: true
